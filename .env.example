# ────────────────────────────────────────────────────────────────
# 复制此文件为 .env 并填入真实值（.env 不会被提交到 Git）
# ────────────────────────────────────────────────────────────────

# Supabase 项目 URL（控制台 → Settings → API → Project URL）
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase API Key
# 商家端使用 Supabase Auth 登录，推荐使用 anon key
# 开发测试可使用 service_role key（跳过 RLS）——生产环境禁止
VITE_SUPABASE_KEY=<your-supabase-anon-or-service-role-key>
